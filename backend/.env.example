# --- App ---
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# --- CockroachDB Cloud ---
# From the CockroachDB Cloud console: Connect > General connection string
COCKROACHDB_URL=postgresql://<user>:<password>@<host>:26257/humin?sslmode=verify-full
# Cloud Managed MCP Server (optional, once provisioned in CockroachDB Cloud)
COCKROACHDB_MCP_URL=
COCKROACHDB_MCP_API_KEY=

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# AWS credentials are picked up from the standard chain (env vars / profile /
# instance role) - do not put access keys in this file.

# --- Trend signal ---
TRENDS_PROVIDER=mock   # "mock" | "google_trends"

# --- Mock switches ---
# Flip both to false once COCKROACHDB_URL is live and AWS credentials are configured.
USE_MOCK_LLM=true
USE_MOCK_DB=true
