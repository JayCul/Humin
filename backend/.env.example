# --- App ---
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# --- CockroachDB Cloud ---
# From the CockroachDB Cloud console: Connect > General connection string
COCKROACHDB_URL=postgresql://<user>:<password>@<host>:26257/humin?sslmode=verify-full
# Cloud Managed MCP Server (optional). The URL is shared across every
# customer/cluster and already defaults correctly - the two things you
# actually need from the CockroachDB Cloud console are the cluster ID and a
# service-account API key (not the interactive OAuth flow `claude mcp add`
# uses - that authenticates a personal CLI session, not an unattended
# backend). Both must be set together or MCP stays "not configured".
# COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACHDB_CLUSTER_ID=
COCKROACHDB_MCP_API_KEY=

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# AWS credentials are picked up from the standard chain (env vars / profile /
# instance role) - do not put access keys in this file.

# --- Trend signal ---
TRENDS_PROVIDER=mock   # "mock" | "google_trends"

# --- Mock switches ---
# Flip both to false once COCKROACHDB_URL is live and AWS credentials are configured.
USE_MOCK_LLM=true
USE_MOCK_DB=true
